# --- Database Settings ---
# PostgreSQLの接続URL (例: jdbc:postgresql://localhost:5432/sudokudb)
DB_URL=jdbc:postgresql://localhost:5432/sudokudb
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# --- OAuth2 / Security Settings ---
# Firebase Auth等のトークン発行元URI (例: https://securetoken.google.com/your-project-id)
ISSUER_URI=https://securetoken.google.com/your-project-id
# OAuth2のAudience (通常はFirebaseのプロジェクトID)
EXPECTED_AUDIENCE=your-project-id

# --- Frontend Connection (CORS) ---
# 接続を許可するオリジン (例: http://localhost:3000)
ALLOWED_ORIGINS=http://localhost:3000

# --- Game Properties ---
# 同時に進行できる数独の個数
MAX_IN_PROGRESS=3
# ヒントを連続使用する際に取らなくてはいけないインターバルの長さ（分）
HINT_INTERVAL_MINUTES=1